# Copy this file to .env and fill in real values. Git ignores .env, so the
# copy with your keys in it can never be committed or pushed.
#
# This file is for running the server on your own machine. The live site reads
# its settings from Render's Environment tab instead, not from any file here.
#
#   npm run start:local        uses .env
#   npm start                  uses the environment as given

# --- Cloudflare R2: private file storage -------------------------------------
# Without all four, the server stores files on local disk exactly as before.
R2_ACCOUNT_ID=
R2_BUCKET=viana-storage
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Owner account, recreated on every start ---------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Admin authenticator key -------------------------------------------------
# 32 random bytes, base64. Generate once and never change it: it encrypts the
# stored authenticator secret, so a new key locks the owner out permanently.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_KEY=

# --- Origins allowed to call this API ----------------------------------------
APP_ORIGIN=http://localhost:5173
